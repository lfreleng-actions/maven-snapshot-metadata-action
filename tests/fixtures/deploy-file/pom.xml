<!--
A reactor of one module whose deploy also writes a second coordinate,
org.lfreleng.test:extra, which help:active-profiles never lists. fetch
seeds nothing for it, so prune must refuse it. deploy-file ignores
altDeploymentRepository, so pass the same repository's URL as
-Dextra.url.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.lfreleng.test</groupId>
  <artifactId>deploy-file-fixture</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <version>3.1.4</version>
        <executions>
          <execution>
            <id>deploy-extra</id>
            <phase>deploy</phase>
            <goals>
              <goal>deploy-file</goal>
            </goals>
            <configuration>
              <file>${project.basedir}/pom.xml</file>
              <groupId>${project.groupId}</groupId>
              <artifactId>extra</artifactId>
              <version>${project.version}</version>
              <packaging>xml</packaging>
              <repositoryId>snapshots</repositoryId>
              <url>${extra.url}</url>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
